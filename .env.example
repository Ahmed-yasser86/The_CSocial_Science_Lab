# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your keys. The backend reads `.env` from
# the repository root. The in-app "AI Config" UI edits the same file.
#
# The app is plug-and-play: for local dev, start Postgres with
#   docker compose up -d
# (docker-compose.yml provisions a DB matching the SOCIAL_DATABASE_URL below),
# then run the backend + frontend. No manual `createdb` is needed — the schema
# (and the database itself) is created automatically on first boot.
# ---------------------------------------------------------------------------

# --- Database (override to point at your own PostgreSQL) ---
SOCIAL_DATABASE_URL=postgresql://postgres:123456@localhost:5432/social_science

# --- LLM / embedding providers (also editable in the in-app AI Config UI) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
STRATEGIC_LLM=
SMART_LLM=
FAST_LLM=
CHAT_MODEL_PROVIDER=
CHAT_MODEL=
EMBEDDING=
GPT_RESEARCHER_EMBEDDING=

# --- Frontend ---
NEXT_PUBLIC_AGENT_BACKEND_URL=http://127.0.0.1:8000
